# ==========================================
# MongoDB Configuration
# ==========================================
# External URI (for local Python execution on Windows)
MONGO_URI=mongodb://localhost:27018/?replicaSet=rs0
# Direct URI used by the simulator (bypasses replica-set topology checks)
MONGO_DIRECT_URI=mongodb://localhost:27018/?directConnection=true
# RS host advertised to Debezium running in WSL — update if WSL IP changes
MONGO_RS_HOST=localhost:27018

# ==========================================
# Kafka Ecosystem
# ==========================================
KAFKA_BROKER_URL=localhost:9092
SCHEMA_REGISTRY_URL=http://localhost:8081
KAFKA_CONNECT_REST_URL=http://127.0.0.1:8083

# ==========================================
# Postgres — P2P + Metrics DB (analytics)
# ==========================================
POSTGRES_ANALYTICS_USER=postgres
POSTGRES_ANALYTICS_PASSWORD=postgres
POSTGRES_ANALYTICS_DB=analytics
POSTGRES_ANALYTICS_PORT=5432
POSTGRES_ANALYTICS_HOST=localhost

# ==========================================
# Neo4j — Local Desktop (Community Edition)
# ==========================================
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=DBMD-Minor
