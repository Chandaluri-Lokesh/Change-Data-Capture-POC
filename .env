# ==========================================
# MongoDB Configuration
# ==========================================
# External URI (for local Python execution)
MONGO_URI=mongodb://localhost:27018/?replicaSet=rs0

# ==========================================
# Kafka Ecosystem
# ==========================================
KAFKA_BROKER_URL=localhost:9092
SCHEMA_REGISTRY_URL=http://localhost:8081
